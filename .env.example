# ---------------------------------------------------------------------------
# NewsVerse environment configuration
# Copy to `.env` and adjust. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Public site origin (no trailing slash). Used for canonical URLs, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite database file (absolute, or relative to the project root).
# The file is the entire database: back it up (see docs/BACKUPS.md).
DATABASE_PATH=./data/newsverse.db

# Server-side secret used to hash reset tokens and visitor fingerprints.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Extra allowed origins for state-changing requests, comma separated.
# Defaults to NEXT_PUBLIC_SITE_URL when empty.
ALLOWED_ORIGINS=

# Insert clearly-labelled demonstration articles on an empty database (1/0).
SEED_DEMO=1

# --- Automated ingestion ---------------------------------------------------
# Start the in-process scheduler (1/0). Set to 0 when an external scheduler
# calls /api/cron/tick instead.
INGEST_AUTO_START=1
# Scheduler tick interval in milliseconds (default 20000).
INGEST_TICK_MS=20000
# Max jobs executed per tick (default 2).
INGEST_MAX_JOBS_PER_TICK=2
# Required by /api/cron/tick when you drive collection externally. If empty,
# the endpoint accepts localhost requests only.
CRON_SECRET=

# --- AI provider (optional) ------------------------------------------------
# Any OpenAI-compatible endpoint. Leave AI_API_KEY empty to use the
# deterministic fallback: extractive summaries and keyword classification,
# with translations marked unavailable rather than invented.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 0 disables AI calls even when a key is present.
AI_ENABLED=1
# Max translation requests per ingestion run (cost control).
AI_TRANSLATIONS_PER_RUN=3

# --- Admin bootstrap (only read by `npm run admin:create`) ------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=NewsVerse Admin
# admin | super_admin
ADMIN_ROLE=admin
